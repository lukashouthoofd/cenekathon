# Copy to .env (git-ignored) and fill in. Never commit real values.
# AI tokens are provided by the organisers on the day.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Vacancy + RAG databases: local files (default src/data/vacancies.duckdb, src/data/rag.duckdb) or MotherDuck.
# Upload the local builds once with src/data/upload_motherduck.py; on Vercel set these three as environment variables.
# VACANCY_DB_PATH=md:vacancies
# RAG_DB_PATH=md:rag
# MOTHERDUCK_TOKEN=
