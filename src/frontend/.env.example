# true = serve built-in fixtures (no backend needed). Anything else = call the real API.
VITE_DEMO_MODE=true
# Base URL of the backend. Empty = same origin (dev server proxies /api to :8000).
VITE_API_BASE=
# Dev-proxy target override is read by vite.config.ts as VITE_API_PROXY (default http://localhost:8000).
